// Shared build settings for the Scoreline target.
//
// Personal signing settings live in Local.xcconfig next to this file.
// It is git-ignored, so updating the project never touches it.
// ios/scripts/setup-mac.sh creates it; you can also copy Local.xcconfig.example.

PRODUCT_BUNDLE_IDENTIFIER = com.rainmaker07.scoreline
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
